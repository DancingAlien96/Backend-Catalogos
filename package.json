{
  "name": "backend-catalogos.com",
  "version": "1.0.0",
  "description": "Backend API para plataforma SaaS multi-tenant de tiendas online con bots de Telegram",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:bots": "nodemon --exec ts-node src/scripts/startBots.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:bots": "node dist/scripts/startBots.js",
    "migrate": "ts-node src/database/migrate.ts",
    "seed": "ts-node src/database/seed.ts",
    "test:session": "ts-node src/scripts/testSessionRedis.ts",
    "test:unit": "jest --config jest.config.cjs",
    "test": "npm run test:unit",
    "lint": "echo \"no lint configured\" && exit 0"
  },
  "keywords": [
    "saas",
    "ecommerce",
    "telegram-bot",
    "multi-tenant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "openai": "^4.104.0",
    "prom-client": "^14.0.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "jest": "^29.6.1",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
